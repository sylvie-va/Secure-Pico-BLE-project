// Template GATT profile for ELEC C7222 Module 10 Task 10.1.
// The database exposes the Immediate Alert Service and the Alert Notification
// Service.

PRIMARY_SERVICE, GAP_SERVICE
CHARACTERISTIC, GAP_DEVICE_NAME, READ, "FindMe-11"

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

// Immediate Alert Service
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_IMMEDIATE_ALERT

CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_ALERT_LEVEL,
DYNAMIC | WRITE | WRITE_AUTHENTICATED | WRITE_ENCRYPTED | WRITE_AUTHORIZED,
CHARACTERISTIC_USER_DESCRIPTION, READ, "IAS Alert Level"


// Alert Notification Service
PRIMARY_SERVICE, ORG_BLUETOOTH_SERVICE_ALERT_NOTIFICATION


CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_SUPPORTED_NEW_ALERT_CATEGORY,
READ | READ_AUTHENTICATED | READ_ENCRYPTED, 01
CHARACTERISTIC_USER_DESCRIPTION, READ, "ANS New Alert Category"

CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_NEW_ALERT,
DYNAMIC | READ | NOTIFY | READ_AUTHENTICATED | READ_ENCRYPTED,
CHARACTERISTIC_USER_DESCRIPTION, READ, "ANS New Alert"


CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_SUPPORTED_UNREAD_ALERT_CATEGORY,
READ | READ_AUTHENTICATED | READ_ENCRYPTED, 01
CHARACTERISTIC_USER_DESCRIPTION, READ, "ANS Unread Alert Category"

CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_UNREAD_ALERT_STATUS,
DYNAMIC | READ | NOTIFY | READ_AUTHENTICATED | READ_ENCRYPTED,
CHARACTERISTIC_USER_DESCRIPTION, READ, "ANS Unread Alert Status"


CHARACTERISTIC, ORG_BLUETOOTH_CHARACTERISTIC_ALERT_NOTIFICATION_CONTROL_POINT,
DYNAMIC | WRITE | WRITE_AUTHENTICATED | WRITE_ENCRYPTED,
CHARACTERISTIC_USER_DESCRIPTION, READ, "ANS Notification Control Point"
